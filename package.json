{
  "name": "table-drummer",
  "version": "1.4.0",
  "description": "A rhythm game you play by hitting a table or clapping. Your microphone is the controller.",
  "author": "Shakir",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "pc": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "android:add": "cap add android && node scripts/android-permissions.js",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shakir.tabledrummer",
    "productName": "Table Drummer",
    "copyright": "Created by Shakir",
    "files": ["electron/**", "www/**"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "www/icons/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Table Drummer" },
    "mac": { "target": "dmg", "icon": "www/icons/icon-512.png", "extendInfo": { "NSMicrophoneUsageDescription": "Table Drummer listens for your taps and claps." } },
    "linux": { "target": "AppImage", "icon": "www/icons/icon-512.png", "category": "Game" }
  }
}
